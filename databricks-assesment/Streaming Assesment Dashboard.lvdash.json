{
  "datasets": [
    {
      "name": "af7b50bc",
      "displayName": "Gold Dataset Aggregated",
      "queryLines": [
        "SELECT\r\n",
        "    window.start AS window_start,\r\n",
        "    window.end AS window_end,\r\n",
        "    symbol,\r\n",
        "    trade_count,\r\n",
        "    gross_value,\r\n",
        "    buy_value,\r\n",
        "    sell_value\r\n",
        "FROM databricks_assesment.gold.stream_gold_symbol_metrics\r\n",
        "ORDER BY window_start;"
      ],
      "catalog": "databricks_assesment",
      "schema": "gold"
    },
    {
      "name": "a33f8e5d",
      "displayName": "Event Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    DATE(window.start) AS event_date,\r\n",
        "    SUM(trade_count) AS total_events\r\n",
        "FROM databricks_assesment.gold.stream_gold_symbol_metrics\r\n",
        "GROUP BY DATE(window.start)\r\n",
        "ORDER BY event_date;"
      ],
      "catalog": "databricks_assesment",
      "schema": "gold"
    },
    {
      "name": "332a7b88",
      "displayName": "Aggregated Gold Market Metrics Summary Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    SUM(gross_value) AS total_gross_value,\r\n",
        "    SUM(trade_count) AS total_trade_count,\r\n",
        "    SUM(buy_value) AS total_buy_value,\r\n",
        "    SUM(sell_value) AS total_sell_value\r\n",
        "FROM databricks_assesment.gold.stream_gold_symbol_metrics;"
      ],
      "catalog": "databricks_assesment",
      "schema": "gold"
    }
  ],
